# Local development only. Generate a private key before sharing this app.
SECRET_KEY=change-this-secret-key
DATABASE_URL=sqlite:///energy_iot_cve_monitor.db
FLASK_ENV=development
NVD_API_KEY=
TELEMETRY_MQTT_BROKER_HOST=test.mosquitto.org
TELEMETRY_MQTT_BROKER_PORT=1883
TELEMETRY_MQTT_TOPIC=energy-iot-cve-monitor/477868883321291777/SolarGuard-01/telemetry
TELEMETRY_MQTT_ACK_TOPIC=energy-iot-cve-monitor/477868883321291777/SolarGuard-01/telemetry/ack
# Optional; keep empty when using the public demonstration broker.
TELEMETRY_MQTT_USERNAME=
TELEMETRY_MQTT_PASSWORD=
TELEMETRY_MQTT_TLS=false
